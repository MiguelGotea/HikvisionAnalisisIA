# ── Entorno VPS ──────────────────────────────────────────────
# Copia este archivo como .env y completa los valores
# El archivo .env NUNCA se sube al repositorio

# Token de autenticación (mismo que usa WSP con api.batidospitaya.com)
HIK_API_TOKEN=c5b155ba8f6877a2eefca0183ab18e37fe9a6accde340cf5c88af724822cbf50

# URL base del API en Hostinger
HIK_API_BASE_URL=https://api.batidospitaya.com/api/hikvision

# IP del VPS (donde corren los túneles SSH)
VPS_IP=198.211.97.243

# Carpeta temporal para videos (dentro del proyecto, NO fuera)
TEMP_DIR=/opt/hikvision-ia/temp

# Número de workers paralelos (1 para testing, aumentar con más sucursales)
WORKER_CONCURRENCY=1

# Segundos de espera entre polls cuando la cola está vacía
POLL_INTERVAL_EMPTY=30

# Segundos de espera entre items procesados
POLL_INTERVAL_ITEM=5

# Timeout de descarga ffmpeg en segundos (extra sobre la duración del video)
FFMPEG_TIMEOUT_EXTRA=120
