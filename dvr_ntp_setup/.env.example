# dvr_ntp_setup — Variables de entorno locales (override)
# Copia este archivo como .env.local y completa solo los valores que
# quieras sobreescribir del .env raíz del proyecto principal.
# Este archivo NUNCA se sube al repositorio (.gitignore ya lo excluye).

# ────────────────────────────────────────────────────────────
# Heredadas del .env principal (no necesitas repetirlas si ya están ahí):
# HIK_API_TOKEN=...
# HIK_API_BASE_URL=https://api.batidospitaya.com/api/hikvision
# ────────────────────────────────────────────────────────────

# ── Servidor NTP a configurar en los DVRs ──────────────────
NTP_SERVER=time.google.com
NTP_PORT=123
NTP_SYNC_INTERVAL=60

# ── Zona horaria Hikvision para Nicaragua (UTC-6, convención invertida) ──
HIK_TIMEZONE=CST+6:00:00

# ── Timeout de conexión a cada DVR (segundos) ─────────────
TIMEOUT_SEGUNDOS=10

# ── Workers paralelos (default 5) ─────────────────────────
MAX_WORKERS=5

# ── Webhook al finalizar (dejar vacío para no enviar) ─────
NTP_WEBHOOK_URL=
# NTP_WEBHOOK_URL=https://erp.batidospitaya.com/api/webhooks/ntp_done.php

# Bearer token para el webhook (opcional) ─────────────────
NTP_WEBHOOK_TOKEN=
