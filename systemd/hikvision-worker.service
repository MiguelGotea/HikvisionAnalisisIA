[Unit]
Description=HikvisionAnalisisIA — Worker de análisis de video con IA
Documentation=https://github.com/tu-org/hikvisionanalisisia
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hikvision-ia

# Activar el venv e iniciar el worker
ExecStart=/opt/hikvision-ia/venv/bin/python -m src.worker

# Reiniciar siempre si cae (delay de 10s para no sobrecargar)
Restart=always
RestartSec=10

# Variables de entorno desde el .env del proyecto
EnvironmentFile=/opt/hikvision-ia/.env

# Logging (journald captura stdout/stderr)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hikvision-worker

# Límites de seguridad
LimitNOFILE=4096
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
